meta {
  name: register_tester
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/register
  body: json
  auth: none
}

body:json {
  {
    "username": "Anicet78310",
    "password": "password123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("Returns approriate status code", function () {
    const status = res.getStatus();
    const body = res.getBody();

    if (status !== 201 && status !== 409)
      throw new Error(`Unexpected status code: ${status}`);
  });

  test("Returns valid data", function () {
    const status = res.getStatus();
    const body = res.getBody();

    if (status === 201) {
      expect(body).to.have.property("data");
      expect(body.data).to.not.be.empty;
      expect(body.data.uuid).to.not.be.empty;
      expect(body.data.username).to.equal("Anicet78310");
      expect(body.data.role).to.equal("user")
      expect(body.data.jwt).to.not.be.empty;
    } else if (status === 409) {
      expect(body).to.have.property("message");
      expect(body.message).to.not.be.empty;
    }
  });
}

script:post-response {
  bru.setEnvVar("testToken", res.body.data.jwt);
}

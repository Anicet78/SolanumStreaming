meta {
  name: register_success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/register
  body: json
  auth: none
}

body:json {
  {
    "username": "Anicet78",
    "password": "password123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("Status code is 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Returns uuid and username", function() {
    expect(res.body.data.uuid);
    expect(res.body.data.username).to.equal("Anicet78");
  });
}

meta {
  name: register_invalid
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/register
  body: json
  auth: none
}

body:json {
  {
    "username": "Anicet78",
    "password": "pa"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("Returns approriate status code", function() {
    expect(res.status).to.equal(400);
  });

  test("Returns appropriate error", function() {
    expect(res.body).to.have.property("message");
    expect(res.body.message).to.not.be.empty;
  });
}

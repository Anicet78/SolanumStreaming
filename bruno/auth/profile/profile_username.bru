meta {
  name: profile_username
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/profile
  body: json
  auth: bearer
}

body:json {
  {
    "new_username": "Anicet67",
    "new_language": "fr-FR"
  }
}

auth:bearer {
  token: {{testToken}}
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("Returns approriate status code", function() {
    expect(res.status).to.equal(204);
  });
}

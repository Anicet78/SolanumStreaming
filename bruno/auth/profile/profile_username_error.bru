meta {
  name: profile_username_error
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/profile
  body: json
  auth: bearer
}

body:json {
  {
    "new_username": "Anicet78"
  }
}

auth:bearer {
  token: {{testToken}}
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("Returns approriate status code", function() {
    expect(res.status).to.equal(409);
  });

  test("Returns appropriate error", function() {
    expect(res.body).to.have.property("message");
    expect(res.body.message).to.not.be.empty;
  });
}

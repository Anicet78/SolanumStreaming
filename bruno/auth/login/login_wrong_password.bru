meta {
  name: login_wrong_password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "username": "Anicet78",
    "password": "password456"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("Status code is 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Returns appropriate error", function() {
    expect(res.body.message);
    expect(res.body.code);
  });
}

meta {
  name: login_success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "username": "Anicet78",
    "password": "password123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("Returns approriate status code", function() {
    expect(res.status).to.equal(200);
  });

  test("Returns valid data", function() {
    const body = res.getBody();

    expect(body).to.have.property("data");
    expect(body.data).to.not.be.empty;
    expect(res.body.data.uuid).to.not.be.empty;
    expect(res.body.data.username).to.equal("Anicet78");
    expect(res.body.data.role).to.equal("user")
    expect(res.body.data.jwt).to.not.be.empty;
  });
}

script:post-response {
  bru.setEnvVar("token", res.body.data.jwt);
}

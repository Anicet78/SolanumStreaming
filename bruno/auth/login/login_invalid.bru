meta {
  name: login_invalid
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "username": "Anicet310",
    "password": "password123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("Status code is 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Returns appropriate error", function() {
    expect(res.body.message);
    expect(res.body.code);
  });
}

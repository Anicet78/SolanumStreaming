meta {
  name: add
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/add
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "movie_id": 194
  }
}

vars:pre-request {
  baseUrl: http://localhost:8082
}

tests {
  test("Returns approriate status code", function() {
    expect(res.status).to.equal(204);
  });
}

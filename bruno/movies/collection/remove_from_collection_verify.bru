meta {
  name: remove_from_collection_verify
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/collection/194
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  baseUrl: http://localhost:8082
}

tests {
  test("Returns approriate status code", function() {
    expect(res.status).to.equal(404);
  });

  test("Returns appropriate error", function() {
    expect(res.body).to.have.property("message");
    expect(res.body.message).to.not.be.empty;
  });
}

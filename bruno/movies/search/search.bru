meta {
  name: search
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/search?title=amelie&page=1
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  baseUrl: http://localhost:8082
}

tests {
  test("Returns approriate status code", function() {
    expect(res.status).to.equal(200);
  });

  test("Returns valid data", function () {
    expect(res.body).to.have.property("data");
    expect(res.body.data).to.not.be.empty;
    expect(res.body.data).to.have.property("page");
    expect(res.body.data.page).to.equal(1);
    expect(res.body.data).to.have.property("results");
    expect(res.body.data.results[0]).to.have.property("id");
    expect(res.body.data.results[0]).to.have.property("title");
    expect(res.body.data.results[0].title).to.not.be.empty;
    expect(res.body.data).to.have.property("total_pages");
    expect(res.body.data).to.have.property("total_results");
  });
}
